{
  "name": "@aiwayds/pi-kimi-cron",
  "version": "1.0.1",
  "description": "Cron scheduling extension for Pi coding agent, inspired by Kimi Code's cron feature",
  "keywords": [
    "pi",
    "pi-extension",
    "cron",
    "scheduling",
    "kimi-code"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "index.ts",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "test": "node --test 'tests/**/*.test.ts'",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.82.0",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@types/node": "^24.12.4",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3"
  },
  "author": "fliu56",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fan56/pi-kimi-cron.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
